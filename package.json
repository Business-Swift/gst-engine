{
  "name": "@business-swift/gst-engine",
  "version": "1.0.2",
  "description": "A TypeScript-first GST engine for India — developed by Business Swift, Made in India 🇮🇳.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && npm run copy-resources",
    "copy-resources": "cp -r src/resources dist/ && cp -r src/resources dist/esm/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "jest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "flexsearch": "^0.7.43"
  },
  "keywords": [
    "gst",
    "hsn",
    "sac",
    "india",
    "tax",
    "invoice",
    "gstin",
    "b2b",
    "b2c",
    "sez",
    "export",
    "typescript"
  ],
  "author": "Business Swift <legal@businessswift.in> (https://businessswift.in)",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5",
    "vitest": "^4.1.8"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "homepage": "https://github.com/businessswift/gst-engine#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/businessswift/gst-engine.git"
  },
  "bugs": {
    "url": "https://github.com/businessswift/gst-engine/issues"
  }
}
